# Orchestrator connection
SWAIF_ORCHESTRATOR_URL=http://localhost:8000

# Agent identity
SWAIF_AGENT_NAME=local-agent-1

# Workspace / safety boundaries
SWAIF_WORKSPACE_ROOT=C:\swaif-workspaces

# Allowlists (absolute paths recommended on Windows)
SWAIF_ALLOWLIST_COMMANDS_FILE=ARTIFACT_BUNDLE\agent-kit\allowlist.commands.txt
SWAIF_ALLOWLIST_PATHS_FILE=ARTIFACT_BUNDLE\agent-kit\allowlist.paths.txt